                      "value": "<string>"
                    },
                    {
                      "key": "updatedAfter",
                      "value": "<dateTime>"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "flow",
                      "description": "(Required) Full dataflow reference, e.g. `OECD.ENV.EPI,DSD_ECH@EXT_DROUGHT,1.0`"
                    },
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "key",
                      "description": "(Required) Dot-separated dimension key (use `all` to retrieve everything)"
                    }
