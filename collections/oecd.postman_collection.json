        {
          "id": "befac9f3-2250-492c-a0f5-7eb8e2c2536f",
          "name": "Retrieve data (SDMX v1.5 path)",
          "request": {
            "name": "Retrieve data (SDMX v1.5 path)",
            "description": {
              "content": "Retrieve observations for a dataflow filtered by a dimension key\n(dot-separated dimension codes). Supports SDMX content negotiation\n(XML / JSON / CSV) via the Accept header.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                ":flow",
                ":key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startPeriod",
                  "value": "<string>",
                  "description": "Start of time period (e.g. 2020)"
                },
                {
                  "disabled": false,
                  "key": "endPeriod",
                  "value": "<string>",
                  "description": "End of time period (e.g. 2024)"
                },
                {
                  "disabled": false,
                  "key": "dimensionAtObservation",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "updatedAfter",
                  "value": "<dateTime>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "flow",
                  "description": "(Required) Full dataflow reference, e.g. `OECD.ENV.EPI,DSD_ECH@EXT_DROUGHT,1.0`"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "key",
                  "description": "(Required) Dot-separated dimension key (use `all` to retrieve everything)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.sdmx.data+json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "6326e02e-fa3f-4bdd-99ef-1c15ac129f13",
              "name": "Data response",
              "originalRequest": {
