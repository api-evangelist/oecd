  "info": {
    "_postman_id": "eca6b64a-e03e-457c-acff-83fda9932998",
    "name": "OECD SDMX REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The OECD provides programmatic access to its statistical data through a\npublic SDMX REST API. Both SDMX REST v1.5.0 and v2.0.0 paths are exposed.\nEndpoints return data and structural metadata (dataflows, code lists,\nconcept schemes, agencies) about OECD datasets. The API is free of charge\nand offered under the OECD Terms and Conditions; no authentication is\nrequired for public data.\n\n\nContact Support:\n Name: OECD Data",
      "type": "text/plain"
    }
  }
